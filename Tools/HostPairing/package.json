  "description": "Pair Pallas Agent and operate your iPhone from DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "cordis.patch.yml",
    "LICENSE.md",
    "bin/pallas-mesh-node",
    "bin/ThirdPartyNotices.txt",
    "mac/dsh-installer-service",
    "mac/Kit/ScreenRunner.ipa",
